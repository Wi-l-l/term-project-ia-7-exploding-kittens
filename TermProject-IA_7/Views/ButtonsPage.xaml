<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TermProject_IA_7.Views.ButtonsPage">
    <ContentPage.Content>
        <VerticalStackLayout>
            <Button Text="Reset Round"
                    Clicked="OnResetRound"/>
            <Button Text="Draw Card"
                    Clicked="OnDrawCard"/>
            <Button Text="New Game"
                    Clicked="OnNewGame"/>
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>