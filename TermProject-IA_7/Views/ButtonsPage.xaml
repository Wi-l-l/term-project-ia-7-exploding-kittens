<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TermProject_IA_7.Views.ButtonsPage">
    <ContentPage.Content>
        <VerticalStackLayout>
            <!--After a player draws an exploding kitten, continue with a new round-->
            <Button Text="Reset Round"
                    Clicked="OnResetRound"/>
            
            <!--Simulate a user drawing a card from the deck-->
            <Button Text="Draw Card"
                    Clicked="OnDrawCard"/>
            
            <!--After the last user wins, start a new game with all users being reset-->
            <Button Text="Start New Game"
                    Clicked="OnNewGame"/>
            
            <!--Save game history-->
            <Button Text="Save Game"
                    Clicked="OnSaveGame"/>
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>